# Environment variables the runtime reads.
#
# The configuration file (docs/telesync.example.json) names these variables;
# it never holds the values itself. Copy to .env and fill in real values, then
# export them before starting the daemon:
#
#   set -a; . ./.env; set +a
#
# Never commit .env.

# --- Secrets referenced by the configuration file ---
# The official credentials come from https://my.telegram.org/apps (API
# development tools). Custom backend credentials come from whatever your
# backend operator issued; they may be the same numbers, but must be set
# explicitly.
OFFICIAL_API_HASH=
# Optional. When empty, `telesync auth --key official` prompts for it.
OFFICIAL_PHONE=

THE_CAT_API_HASH=
# Optional. When empty, `telesync auth --key the-cat` prompts for it.
THE_CAT_PHONE=

# --- Runtime ---
# Absolute or relative path to the JSON configuration file.
TELESYNC_CONFIG=./telesync.json

# Signing key for the API's access tokens (HS256, at least 32 bytes). The
# configuration's api.jwt.secret_env names this variable. Required when the API
# binds to anything other than loopback; without it, login is disabled.
# Generate with: openssl rand -base64 48
# TELESYNC_JWT_SECRET=

# Key that encrypts registered WordPress application passwords at rest
# (AES-256-GCM). The configuration's api.wordpress.encryption_key_env names
# this variable (docs/telesync.example.json instead names a *path*, for the
# container: set only one of encryption_key_env, encryption_key_path or
# encryption_key). Without it the WordPress site routes answer 503 and nothing
# is stored. Generate it once and keep it: a new key cannot open credentials
# sealed with the old one. Generate with: openssl rand -base64 32
# TELESYNC_WORDPRESS_KEY=

# Optional fixed operator token, accepted only while the API binds to loopback.
# The configuration's api.auth_token_env names this variable; the name here is
# only a convention until `"auth_token_env": "TELESYNC_API_TOKEN"` is set under
# api. It is for scripts and first setup; use logins for anything reachable
# from a network.
# TELESYNC_API_TOKEN=

# Optional. Set to any value to send gotd's verbose handshake logs to stderr.
# TELESYNC_DEBUG=1
